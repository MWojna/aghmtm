#include <stm32f429i_discovery_ts.h>
#include <stm32f429i_discovery_lcd.h>
#include "KeyboardTs.h"

KeyboardTs::KeyboardTs(unsigned char ucKoll) {
	int iX = BSP_LCD_GetXSize();
	int iY = BSP_LCD_GetYSize();
	BSP_TS_Init(iX, iY);
	ucKbKol = ucKoll;
}

KEYBOARD KeyboardTs::eRead() {
	TS_StateTypeDef ts_state;
	BSP_TS_GetState(&ts_state);
	if (ts_state.TouchDetected > 0) {
		switch (ts_state.X) {
			case 0 ... 80:
				switch (ts_state.Y) {
					case 0 ... 80:
						return BUTTON_0;
						break;
					case 81 ... 160:
						return BUTTON_1;
						break;
					case 161 ... 240:
						return BUTTON_2;
						break;
					case 241 ... 320:
						return BUTTON_3;
						break;
					default:
						return UNPRESSED;;
						break;
				}
				default:
					return UNPRESSED;
					break;
		}
	}
	return UNPRESSED;
}
