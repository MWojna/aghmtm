#include <stm32f429i_discovery_ts.h>
#include <stm32f429i_discovery_lcd.h>
#include "KeyboardTs.h"

KeyboardTs::KeyboardTs() {
	int iXPos = BSP_LCD_GetXSize();
	int iYPos = BSP_LCD_GetYSize();

	BSP_TS_Init(iXPos, iYPos);
}

KEYBOARD KeyboardTs::eRead() {
	TS_StateTypeDef ts_state;
	BSP_TS_GetState(&ts_state);

    if(ts_state.TouchDetected == 0) {
        return UNPRESSED;
    }

	if(ts_state.X >= WIDTH) {
		return UNPRESSED;
	}

	for(unsigned char ucCurrentButton = 1; ucCurrentButton <= BUTTON_COUNT; ucCurrentButton++) {
		if(ts_state.Y <= (ucCurrentButton * HEIGHT)) {
			return static_cast<KEYBOARD>(ucCurrentButton);
		}
	}

	return UNPRESSED;
}
